rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'ROLE_ADMIN' || request.auth.token.admin == true);
    }

    function isApprovedArtisan() {
      return isAuthenticated() && request.auth.token.artisanApproved == true &&
        request.auth.token.artisanId is string;
    }

    function ownsArtisan(artisanId) {
      return isApprovedArtisan() && request.auth.token.artisanId == artisanId;
    }

    function validBookingTransition(from, to) {
      return (from == 'draft' && to in ['broadcasting', 'cancelledByCustomer']) ||
        (from == 'broadcasting' && to in ['claimed', 'dispatchFailed', 'cancelledByCustomer']) ||
        (from == 'claimed' && to in ['assigned', 'dispatchFailed', 'cancelledByArtisan', 'cancelledByCustomer']) ||
        (from == 'assigned' && to in ['artisanEnRoute', 'dispatchFailed', 'cancelledByArtisan', 'cancelledByCustomer']) ||
        (from == 'artisanEnRoute' && to in ['artisanArrived', 'dispatchFailed', 'cancelledByArtisan', 'cancelledByCustomer']) ||
        (from == 'artisanArrived' && to in ['workInProgress', 'dispatchFailed', 'cancelledByArtisan', 'cancelledByCustomer']) ||
        (from == 'workInProgress' && to in ['partsPendingApproval', 'completionPendingOtp', 'dispatchFailed', 'cancelledByArtisan', 'cancelledByCustomer']) ||
        (from == 'partsPendingApproval' && to in ['workInProgress', 'completionPendingOtp']) ||
        (from == 'completionPendingOtp' && to == 'completed') ||
        (from == 'completed' && to in ['settled', 'disputed']) ||
        (from == 'disputed' && to == 'settled') ||
        (from == 'dispatchFailed' && to in ['broadcasting', 'cancelledByCustomer']) ||
        (from == 'cancelledByArtisan' && to == 'dispatchFailed');
    }

    function hasBookingTransitionAudit() {
      let prior = resource.data.get('statusEvents', []);
      let next = request.resource.data.statusEvents;
      let event = next[next.size() - 1];
      return next.size() == prior.size() + 1 &&
        event.from == resource.data.status &&
        event.to == request.resource.data.status &&
        (event.actorId == request.auth.uid ||
          (isApprovedArtisan() && event.actorId == request.auth.token.artisanId)) &&
        event.eventKey is string && event.eventKey.size() > 0 &&
        event.occurredAt is string;
    }

    // Public / Reference Collections
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();

      match /localities/{localityId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /trades/{tradeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // User Accounts
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.activeRole in ['customer', 'artisan'] &&
        request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'phone', 'activeRole', 'cityId',
          'artisanId', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.activeRole in ['customer', 'artisan'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'activeRole', 'cityId', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    // Private artisan application and immutable decision history. Clients can
    // submit safe profile fields, but only trusted functions can change review
    // states or write audit events.
    match /artisan_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.artisanId == ('art_' + userId) &&
        request.resource.data.status in ['draft', 'submitted'] &&
        request.resource.data.keys().hasOnly([
          'userId', 'artisanId', 'phone', 'name', 'tradeId', 'cityId',
          'localityId', 'step', 'status', 'updatedAt'
        ]);
      allow update: if isAdmin() || (isOwner(userId) &&
        resource.data.status in ['draft', 'needs_action'] &&
        request.resource.data.userId == userId &&
        request.resource.data.artisanId == ('art_' + userId) &&
        request.resource.data.status in ['draft', 'submitted'] &&
        request.resource.data.keys().hasOnly([
          'userId', 'artisanId', 'phone', 'name', 'tradeId', 'cityId',
          'localityId', 'step', 'status', 'updatedAt'
        ]));
      allow delete: if isAdmin();

      match /review_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // Artisan Guild Profiles
    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (ownsArtisan(artisanId) &&
        request.resource.data.artisanId == artisanId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'primaryTradeId', 'tradeTitle', 'yearsExperience', 'bio',
          'inspectionFee', 'cityId', 'localityId', 'isOnline',
          'dailyDihadiRate', 'workMode', 'serviceLocalityIds', 'specialties',
          'verifiedTools', 'portfolioItems'
        ]));
      allow delete: if isAdmin();
    }

    // Bookings & Dispatch Radar
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        ownsArtisan(resource.data.assignedArtisanId) ||
        (resource.data.status == 'broadcasting' && isApprovedArtisan()) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['draft', 'broadcasting'] &&
        request.resource.data.get('assignedArtisanId', null) == null &&
        request.resource.data.get('statusEvents', []).size() == 0 &&
        request.resource.data.idempotencyKey is string &&
        request.resource.data.idempotencyKey.size() > 0;
      allow update: if hasBookingTransitionAudit() &&
        validBookingTransition(resource.data.status, request.resource.data.status) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusEvents', 'assignedArtisanId', 'assignedArtisanName',
          'assignedArtisanPhone', 'arrivalTime', 'completionTime',
          'dwellMinutesAtDestination'
        ]) && (
          isAdmin() ||
          (resource.data.customerId == request.auth.uid &&
            (request.resource.data.status == 'cancelledByCustomer' ||
             (resource.data.status == 'completionPendingOtp' &&
              request.resource.data.status == 'completed') ||
             (resource.data.status == 'dispatchFailed' &&
              request.resource.data.status == 'broadcasting')) &&
            request.resource.data.assignedArtisanId == resource.data.assignedArtisanId) ||
          (ownsArtisan(resource.data.assignedArtisanId) &&
            request.resource.data.status != 'claimed' &&
            request.resource.data.assignedArtisanId == resource.data.assignedArtisanId) ||
          (resource.data.status == 'broadcasting' &&
            request.resource.data.status == 'claimed' &&
            isApprovedArtisan() &&
            request.resource.data.assignedArtisanId == request.auth.token.artisanId)
        );
      allow delete: if isAdmin();
    }

    // UPI mandate records. Client-side writes are restricted to a user's own
    // pre-auth record; capture/release will move to the privileged T-12
    // webhook gateway once payment providers are connected.
    match /mandates/{mandateId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Wallets & Ledger
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (request.auth.uid == walletId || isAdmin());
      allow write: if isAdmin();

      match /ledger/{entryId} {
        allow read: if isAuthenticated() && (request.auth.uid == walletId || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Platform Configuration & Operational Telemetry
    match /platform_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
